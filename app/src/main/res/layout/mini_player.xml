<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/purple_500"
    app:cardCornerRadius="@dimen/corner_radius_16">

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/MiniPlayerStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_view_mini_player"
            android:layout_width="@dimen/button_width_48"
            android:layout_height="@dimen/button_height_48"
            android:layout_marginStart="@dimen/margin_start_16"
            android:layout_marginTop="@dimen/margin_top_8"
            android:layout_marginBottom="@dimen/margin_bottom_8"
            android:background="@android:color/transparent"
            app:cardCornerRadius="@dimen/corner_radius_200"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/img_mini_player"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:ignore="ContentDescription,ImageContrastCheck"
                tools:srcCompat="@tools:sample/avatars" />
        </androidx.cardview.widget.CardView>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5" />

        <TextView
            android:id="@+id/tv_title_miniplayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_start_8"
            android:layout_marginEnd="@dimen/margin_end_8"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:text="@string/txt_song_title"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            app:layout_constraintBottom_toTopOf="@+id/guideline5"
            app:layout_constraintEnd_toStartOf="@+id/btn_favorite_mini_player"
            app:layout_constraintStart_toEndOf="@+id/card_view_mini_player"
            app:layout_constraintTop_toTopOf="@+id/card_view_mini_player" />

        <TextView
            android:id="@+id/tv_artist_mini_player"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_bottom_4"
            android:alpha="0.7"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:text="@string/txt_song_artist"     android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tv_title_miniplayer"
            app:layout_constraintStart_toStartOf="@+id/tv_title_miniplayer"
            app:layout_constraintTop_toTopOf="@+id/guideline5"
            tools:ignore="TextContrastCheck" />

        <ImageButton
            android:id="@+id/btn_favorite_mini_player"
            android:layout_width="@dimen/width_27"
            android:layout_height="@dimen/height_27"
            android:layout_marginEnd="@dimen/margin_end_8"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toTopOf="@+id/guideline5"
            app:layout_constraintEnd_toStartOf="@+id/btn_pause_play_mini_player"
            app:layout_constraintTop_toTopOf="@+id/guideline5"
            app:srcCompat="@drawable/ic_favorite_off"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/btn_pause_play_mini_player"
            android:layout_width="@dimen/button_width_48"
            android:layout_height="@dimen/button_height_48"
            android:layout_marginEnd="@dimen/margin_end_8"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="@+id/btn_favorite_mini_player"
            app:layout_constraintEnd_toStartOf="@+id/btn_skip_next_mini_player"
            app:layout_constraintTop_toTopOf="@+id/btn_favorite_mini_player"
            app:srcCompat="@drawable/ic_play_circle_48px"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

        <ImageButton
            android:id="@+id/btn_skip_next_mini_player"
            android:layout_width="@dimen/button_width_32"
            android:layout_height="@dimen/button_height_32"
            android:layout_marginEnd="@dimen/margin_end_4"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="@+id/btn_pause_play_mini_player"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_pause_play_mini_player"
            app:srcCompat="@drawable/ic_skip_next_48px"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>