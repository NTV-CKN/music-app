<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/include_show_song_option_menu"
        layout="@layout/item_show_song_option_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_8"
        android:layout_marginBottom="@dimen/margin_bottom_8" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_1"
        android:layout_marginStart="@dimen/margin_start_16"
        android:layout_marginEnd="@dimen/margin_end_16"
        android:background="@color/material_dynamic_primary50" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_song_option_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_end_16"
        android:layout_marginTop="@dimen/margin_top_8"
        android:layout_marginEnd="@dimen/margin_end_16"
        android:layout_marginBottom="@dimen/margin_bottom_16"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_option_menu_song" />
</LinearLayout>