<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".ui.home.album.AlbumFragment">

    <TextView
        android:id="@+id/tv_label_album"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_start_16"
        android:layout_marginTop="@dimen/margin_top_8"
        android:text="@string/txt_album"
        android:textAppearance="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_more_album"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_start_8"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_outline_arrow_forward_ios_24"
        app:layout_constraintBottom_toBottomOf="@+id/tv_label_album"
        app:layout_constraintStart_toEndOf="@+id/tv_label_album"
        app:layout_constraintTop_toTopOf="@+id/tv_label_album"
        tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_album"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_start_16"
        android:layout_marginTop="@dimen/margin_top_8"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_label_album"
        tools:listitem="@layout/item_album" />

    <ProgressBar
        android:id="@+id/progress_album"
        style="?android:attr/absListViewStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_end_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_label_album"
        app:layout_constraintEnd_toEndOf="@+id/rv_album"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/btn_more_album"
        app:layout_constraintTop_toTopOf="@+id/tv_label_album" />

</androidx.constraintlayout.widget.ConstraintLayout>