<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/img_item_option_bottom_sheet"
        android:layout_margin="@dimen/margin_4dp"
        android:layout_width="@dimen/button_width_30"
        android:layout_height="@dimen/button_height_30"
        android:background="@android:color/transparent"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/tv_name_item_option_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/margin_start_16"
        android:layout_marginEnd="@dimen/margin_end_16"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:textAlignment="textStart"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium" />
</LinearLayout>