<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".ui.home.rcm_song.RecommendSongFragment">

    <TextView
        android:id="@+id/tv_title_rcm_song"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_start_16"
        android:layout_marginTop="@dimen/margin_top_8"
        android:text="@string/txt_recommend_song"
        android:textAppearance="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_more_rcm_song"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_start_8"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_outline_arrow_forward_ios_24"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_rcm_song"
        app:layout_constraintStart_toEndOf="@+id/tv_title_rcm_song"
        app:layout_constraintTop_toTopOf="@+id/tv_title_rcm_song"
        tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

