<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_search_song"
    app:startDestination="@id/navigate_search_song_history">

    <fragment
        android:id="@+id/navigate_search_song_history"
        android:name="com.infix.musicappv1.ui.search.history.SearchSongHistoryFragment"
        android:label="fragment_search_song_history"
        tools:layout="@layout/fragment_search_song_history" >
        <action
            android:id="@+id/action_navigate_search_song_history_to_navigate_result_search_song"
            app:destination="@id/navigate_result_search_song" />
    </fragment>
    <fragment
        android:id="@+id/navigate_result_search_song"
        android:name="com.infix.musicappv1.ui.search.result.ResultSearchSongFragment"
        android:label="fragment_result_search_song"
        tools:layout="@layout/fragment_result_search_song" >
        <action
            android:id="@+id/action_navigate_result_search_song_to_navigate_search_song_history"
            app:destination="@id/navigate_search_song_history" />
    </fragment>

</navigation>