<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_admin"
    app:startDestination="@id/navigate_manage_songs">

    <fragment
        android:id="@+id/navigate_manage_songs"
        android:name="com.infix.musicappv1.ui.admin.song.SongManagementFragment"
        android:label="@string/txt_manage_song"
        tools:layout="@layout/fragment_song_management">
        <action
            android:id="@+id/action_navigate_song_management_to_add_or_update_song"
            app:destination="@id/navigate_add_or_update_song"
            app:enterAnim="@anim/slide_left"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_right" />
    </fragment>
    <fragment
        android:id="@+id/navigate_add_or_update_song"
        android:name="com.infix.musicappv1.ui.admin.song.update_add.AddOrUpdateSongFragment"
        android:label="{addOrUpdate}"
        tools:layout="@layout/fragment_add_or_update_song">
        <argument
            android:name="addOrUpdate"
            android:defaultValue="@string/txt_update_song"
            app:argType="reference" />
    </fragment>
    <fragment
        android:id="@+id/navigate_manage_albums"
        android:name="com.infix.musicappv1.ui.admin.album.AlbumManagementFragment"
        android:label="@string/txt_manage_album"
        tools:layout="@layout/fragment_album_management">
        <action
            android:id="@+id/action_navigate_manage_albums_to_navigate_add_or_update_album"
            app:destination="@id/navigate_add_or_update_album"
            app:enterAnim="@anim/slide_left"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_right" />
    </fragment>
    <fragment
        android:id="@+id/navigate_add_or_update_album"
        android:name="com.infix.musicappv1.ui.admin.album.update_add.AddOrUpdateAlbumFragment"
        android:label="{addOrUpdate}"
        tools:layout="@layout/fragment_add_or_update_album">
        <argument
            android:name="addOrUpdate"
            android:defaultValue="@string/txt_update_album"
            app:argType="reference" />
    </fragment>
    <fragment
        android:id="@+id/navigate_manage_artists"
        android:name="com.infix.musicappv1.ui.admin.artist.ArtistManagementFragment"
        android:label="@string/txt_manage_artist"
        tools:layout="@layout/fragment_artist_management">
        <action
            android:id="@+id/action_navigate_manage_artists_to_navigate_add_or_update_artist"
            app:destination="@id/navigate_add_or_update_artist"
            app:enterAnim="@anim/slide_left"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_right" />
    </fragment>
    <fragment
        android:id="@+id/navigate_add_or_update_artist"
        android:name="com.infix.musicappv1.ui.admin.artist.add_update.AddOrUpdateArtistFragment"
        android:label="{addOrUpdate}"
        tools:layout="@layout/fragment_add_or_update_artist">
        <argument
            android:name="addOrUpdate"
            android:defaultValue="@string/txt_update_album"
            app:argType="reference" />
    </fragment>
    <fragment
        android:id="@+id/navigate_manage_vip_packages"
        android:name="com.infix.musicappv1.ui.admin.subscription.SubscriptionManagementFragment"
        android:label="@string/txt_manage_subscriptions"
        tools:layout="@layout/fragment_subscription_management">
        <action
            android:id="@+id/action_navigate_manage_vip_packages_to_navigate_add_or_update_subscription"
            app:destination="@id/navigate_add_or_update_subscription"
            app:enterAnim="@anim/slide_left"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_right" />
    </fragment>
    <fragment
        android:id="@+id/navigate_add_or_update_subscription"
        android:name="com.infix.musicappv1.ui.admin.subscription.add_update.AddOrUpdateSubscriptionFragment"
        android:label="{addOrUpdate}"
        tools:layout="@layout/fragment_add_or_update_subscription">
        <argument
            android:name="addOrUpdate"
            android:defaultValue="@string/txt_update_album"
            app:argType="reference" />
    </fragment>
</navigation>