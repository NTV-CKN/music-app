<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MusicAppV1" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <style name="ToolbarStyle" parent="Widget.Material3.Toolbar">
        <item name="navigationIcon">@drawable/ic_baseline_arrow_back_24</item>
<!--        <item name="android:background">@drawable/background_toolbar</item>-->
    </style>
    <style name="MiniPlayerStyle">
        <item name="android:background">@color/black_light</item>
    </style>

    <style name="SearchViewStyle" parent="Widget.Material3.SearchView">
        <item name="android:searchHintIcon">@drawable/ic_search_24px</item>
        <item name="android:tint">@color/white</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="closeIconTint">@color/red</item>
    </style>

    <style name="KeySearchSongStyle" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:backgroundTint">@color/black_light</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>